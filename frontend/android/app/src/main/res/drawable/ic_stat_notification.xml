<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar / notification small icon: pure white shapes on a transparent
     background (Android tints it). A speedometer: dial arc, ticks and needle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- dial: 270-degree arc, open at the bottom -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M6.1,18 A8,8 0 1 1 17.9,18" />
    <!-- needle -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M12,13 L16,8" />
    <!-- hub -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,13m-1.6,0a1.6,1.6 0 1,0 3.2,0a1.6,1.6 0 1,0 -3.2,0" />
</vector>
